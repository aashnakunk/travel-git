# Copy this file to ".env" (and ".env.local") and fill in real values.
# ".env" and ".env.local" are gitignored and never committed.
#
# On Railway, set these as service variables instead of committing them.
# NOTE: VITE_* vars are read at BUILD time and baked into the frontend bundle,
# so they must be present when `npm run build` runs.

# --- Backend (server) — secret, never shipped to the browser ---------------
# OpenAI — powers itinerary planning and the agentic editor
OPENAI_API_KEY=sk-proj-...

# Tavily — web search to ground the agent's suggestions in real places
TAVILY_API_KEY=tvly-...

# Optional: override the OpenAI model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Port the server listens on (Railway injects PORT automatically in prod)
PORT=8787

# --- Frontend (Vite) — safe to expose; RLS governs data access -------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
